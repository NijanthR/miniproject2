# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ==========================================

# Render Backend URL (Do NOT include a trailing slash)
VITE_API_BASE_URL=https://your-backend-name.onrender.com

# WebSocket URL for Real-Time Community Lounge
VITE_WS_BASE_URL=wss://your-backend-name.onrender.com

# Google OAuth Client ID (if using Google Login)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

VITE_APP_NAME=AI Teaching Assistant
