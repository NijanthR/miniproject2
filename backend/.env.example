# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==========================================

# Django Security
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# LLM Providers (NVIDIA NIM & Google Gemini)
NVIDIA_API=your_nvidia_api_key_here
gemini_api_key=your_gemini_api_key_here

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-app-name.vercel.app/app

# CORS & CSRF (Include your Vercel frontend domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app-name.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app-name.vercel.app,https://your-backend-name.onrender.com
CORS_ALLOW_ALL_ORIGINS=False

# Database (Render automatically injects DATABASE_URL if using Render Postgres)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
